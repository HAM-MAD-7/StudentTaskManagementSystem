@model List<StudentTaskModel>
<style>

    @@media (max-width: 768px) {

        h1 {
            font-size: 1.8rem !important;
            padding: 15px !important;
        }

        table {
            min-width: 900px;
        }

        th, td {
            font-size: 14px;
            padding: 10px !important;
        }

        a {
            padding: 8px 14px !important;
            font-size: 13px !important;
        }
    }

    @@media (max-width: 576px) {

        h1 {
            font-size: 1.5rem !important;
            padding: 12px !important;
        }

        table {
            min-width: 850px;
        }

        th, td {
            font-size: 12px;
            padding: 8px !important;
        }

        span {
            padding: 4px 8px !important;
            font-size: 11px !important;
        }

        a {
            padding: 6px 10px !important;
            font-size: 12px !important;
        }
    }

</style>

<h1 style="
    text-align:center;
    font-family:'Bookman Old Style';
    font-weight:bold;
    color:white;
    background:linear-gradient(135deg,#4f46e5,#7c3aed);
    padding:18px;
    border-radius:15px;
    margin-bottom:25px;
    box-shadow:0 10px 25px rgba(79,70,229,0.3);
    ">
    📋 All Tasks
</h1>

<div style="
    overflow-x:auto;
    background:white;
    border-radius:20px;
    box-shadow:0 15px 35px rgba(0,0,0,0.12);
    padding:10px;
    ">

    <table style="
        width:100%;
        border-collapse:separate;
        border-spacing:0;
        font-family:'Bookman Old Style';
        ">

        <thead>
            <tr style="
                background:linear-gradient(135deg,#4f46e5,#7c3aed);
                color:white;
                ">

                <th style="
                    padding:15px;
                    border-top-left-radius:15px;
                    ">
                    #
                </th>

                <th style="padding:15px;">📚 Subject</th>

                <th style="padding:15px;">📝 Task</th>

                <th style="padding:15px;">⚡ Priority</th>

                <th style="padding:15px;">📄 Description</th>

                <th style="padding:15px;">📅 Due Date</th>

                <th style="padding:15px;">📌 Status</th>

                <th style="
                    padding:15px;
                    text-align:center;
                    width:300px;
                    border-top-right-radius:15px;
                    ">
                    ⚙️ Actions
                </th>

            </tr>
        </thead>

        <tbody>

            @foreach (var tks in Model)
            {
                <tr style="
                    background:#ffffff;
                    border-bottom:1px solid #e5e7eb;
                    transition:0.3s;
                    ">

                    <td style="
                        padding:14px;
                        text-align:center;
                        font-weight:bold;
                        ">
                        @tks.TaskId
                    </td>

                    <td style="padding:14px;">
                        @tks.SubjectName
                    </td>

                    <td style="padding:14px;">
                        @tks.TaskName
                    </td>

                    <td style="padding:14px;">
                        <span style="
                            background:#fff7ed;
                            color:#ea580c;
                            padding:6px 12px;
                            border-radius:20px;
                            font-weight:bold;
                            ">
                            @tks.TaskPriority
                        </span>
                    </td>

                    <td style="padding:14px;">
                        @tks.TaskDescription
                    </td>

                    <td style="
                        padding:14px;
                        text-align:center;
                        font-weight:bold;
                        ">
                        @tks.DueDate.ToString("yyyy-MM-dd")
                    </td>

                    <td style="padding:14px;">
                        <span style="
                            background:#ecfdf5;
                            color:#16a34a;
                            padding:6px 12px;
                            border-radius:20px;
                            font-weight:bold;
                            ">
                            @tks.TaskStatus
                        </span>
                    </td>

                    <td style="text-align:center;padding:14px;white-space:nowrap;">

                        <a href="/StudentTask/EditTask/@tks.TaskId"
                               style="
                            display:inline-block;
                            padding:10px 18px;
                            background:linear-gradient(135deg,#f59e0b,#ef4444);
                            color:white;
                            text-decoration:none;
                            border-radius:10px;
                            font-weight:bold;
                            box-shadow:0 5px 12px rgba(245,158,11,0.3);
                            transition:0.3s;
                            "
                               onmouseover="
                            this.style.transform='translateY(-3px)';
                            this.style.boxShadow='0 10px 20px rgba(245,158,11,0.4)';
                            "
                               onmouseout="
                            this.style.transform='translateY(0px)';
                            this.style.boxShadow='0 5px 12px rgba(245,158,11,0.3)';
                            ">
                            ✏️ Edit
                        </a>

                        <span style="
                            margin:0 10px;
                            font-weight:bold;
                            color:#6b7280;
                            font-size:18px;">
                            |
                        </span>

                        <a href="/StudentTask/DeleteTask/@tks.TaskId"
                               onclick="confirmDelete(event,this)"
                               style="
                            display:inline-block;
                            padding:10px 18px;
                            background:linear-gradient(135deg,#dc2626,#b91c1c);
                            color:white;
                            text-decoration:none;
                            border-radius:10px;
                            font-weight:bold;
                            box-shadow:0 5px 12px rgba(220,38,38,0.3);
                            transition:0.3s;
                            "
                               onmouseover="
                            this.style.transform='translateY(-3px)';
                            this.style.boxShadow='0 10px 20px rgba(220,38,38,0.4)';
                            "
                               onmouseout="
                            this.style.transform='translateY(0px)';
                            this.style.boxShadow='0 5px 12px rgba(220,38,38,0.3)';
                            ">
                            🗑️ Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<script>

    function confirmDelete(event, element) {

        event.preventDefault();

        Swal.fire({
            title: 'Delete Task?',
            text: 'This task will be permanently removed.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6366f1',
            confirmButtonText: '🗑️ Yes, Delete',
            cancelButtonText: 'Cancel',
            background: '#ffffff',
            borderRadius: '20px'
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href = element.href;

            }

        });

    }

</script>