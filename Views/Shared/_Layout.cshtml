<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentTaskManagementSystem</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentTaskManagementSystem.styles.css" asp-append-version="true" />

    <style>

            body {
                background: linear-gradient(135deg,#eef2ff,#e0f2fe);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .navbar-custom {
                background: linear-gradient(135deg,#4f46e5,#7c3aed);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            }

            .navbar-brand {
                font-family: 'Bookman Old Style';
                font-weight: bold;
                font-size: 24px;
                transition: all 0.3s ease;
            }

                .navbar-brand:hover {
                    transform: scale(1.05);
                }

            .nav-link {
                color: white !important;
                font-weight: bold;
                font-family: 'Bookman Old Style';
                border-radius: 10px;
                padding: 10px 18px !important;
                transition: all 0.3s ease;
            }

                .nav-link:hover {
                    background: rgba(255,255,255,0.20);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 12px rgba(255,255,255,0.15);
                }

            .main-card {
                background: white;
                border-radius: 20px;
                padding: 25px;
                box-shadow: 0 15px 35px rgba(0,0,0,0.10);
                transition: all 0.3s ease;
            }

                .main-card:hover {
                    box-shadow: 0 20px 45px rgba(0,0,0,0.15);
                }

            .footer-custom {
                background: linear-gradient(135deg,#4f46e5,#7c3aed);
                color: white;
                padding: 18px;
                margin-top: 30px;
                box-shadow: 0 -5px 15px rgba(0,0,0,0.15);
                font-family: 'Bookman Old Style';
                font-weight: bold;
                transition: all 0.3s ease;
            }

                .footer-custom:hover {
                    letter-spacing: 1px;
                }


            @@media (max-width: 768px) {

                .navbar-brand {
                    font-size: 20px !important;
                }

                .nav-link {
                    text-align: center;
                    margin-top: 5px;
                }

                .main-card {
                    padding: 20px !important;
                    border-radius: 15px !important;
                }

                .container {
                    padding-left: 12px !important;
                    padding-right: 12px !important;
                }

                .footer-custom {
                    font-size: 14px;
                    padding: 15px;
                }
            }

            @@media (max-width: 576px) {

                .navbar-brand {
                    font-size: 16px !important;
                    line-height: 1.4;
                }

                .navbar-toggler {
                    padding: 4px 8px;
                }

                .nav-link {
                    font-size: 14px;
                    padding: 10px !important;
                }

                .main-card {
                    padding: 15px !important;
                    border-radius: 12px !important;
                }

                .container {
                    padding-left: 8px !important;
                    padding-right: 8px !important;
                }

                .footer-custom {
                    font-size: 12px;
                    padding: 12px;
                }
            }

    </style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">

            <div class="container-fluid">

                <a class="navbar-brand"
                       asp-area=""
                       asp-controller="StudentTask"
                       asp-action="Index">
                    📚 Student Task Management System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse" id="navbarNav">

                    <!-- Left Side -->
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="StudentTask"
                                   asp-action="Index">
                                🏠 Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Blob"
                               asp-action="Upload">
                                🗃️ Upload File
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Queue"
                               asp-action="Receive">
                                🎫 Receive Message
                            </a>
                        </li>
                    </ul>

                    <!-- Right Side -->
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="UserCredential"
                                   asp-action="RegisterUser">
                                ✨ Sign Up
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="UserCredential"
                                   asp-action="LoginUser">
                                🔐 Login
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="UserCredential"
                                   asp-action="LogoutUser">
                                🚪 Log Out
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container flex-grow-1">

        <main role="main" class="pb-3 mt-4">

            <div class="main-card">

                @RenderBody()

            </div>

        </main>

    </div>

    <footer class="footer text-center footer-custom">

        <div class="container">

            🚀 &copy; 2026 - StudentTaskManagementSystem

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>